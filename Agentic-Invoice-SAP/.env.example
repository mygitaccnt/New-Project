# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# SAP S/4HANA OData (API_SUPPLIERINVOICE_PROCESS_SRV)
SAP_BASE_URL=https://my-s4hana-system.example.com
SAP_USERNAME=SVC_INVOICE_AGENT
SAP_PASSWORD=change-me
SAP_CLIENT=100
SAP_DEFAULT_COMPANY_CODE=1000
# GL account used when an invoice has no PO reference and no per-line GL
# account of its own. Must exist in your chart of accounts.
SAP_GL_ACCOUNT_FALLBACK=0000400000

# Pipeline I/O
PDF_INBOX_DIR=./data/inbox
PDF_PROCESSED_DIR=./data/processed
PDF_FAILED_DIR=./data/failed
LEDGER_DB_PATH=./data/ledger.sqlite3
POLL_INTERVAL_SECONDS=60
